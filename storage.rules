rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /artworks/{userId}/pending/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size > 0 &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png|image/webp)$') &&
        request.resource.metadata.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /artworks/{userId}/orders/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
