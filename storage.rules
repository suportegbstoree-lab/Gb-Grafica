rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function validAdminEpoch(access) {
      return access.get('schemaVersion', 0) == 1 && access.get('enabled', false) == true &&
        access.get('epoch', '') is string &&
        ((access.epoch == 'legacy' && !('gbAdminEpoch' in request.auth.token)) ||
         (access.epoch.matches('^[a-f0-9]{32}$') && request.auth.token.get('admin', false) == true &&
          request.auth.token.get('gbAdminEpoch', '') == access.epoch));
    }

    function currentAdminAccess() {
      let path = /databases/(default)/documents/_adminAccess/$(request.auth.uid);
      return firestore.exists(path) && validAdminEpoch(firestore.get(path).data);
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true && currentAdminAccess();
    }

    function validStaffToken() {
      return request.auth != null && request.auth.token.get('admin', false) != true &&
        request.auth.token.get('staffRole', '') in ['designer', 'product-manager'] &&
        request.auth.token.get('gbStaffEpoch', '').matches('^[a-f0-9]{32}$');
    }

    function staffCan(permission) {
      let access = firestore.get(/databases/(default)/documents/_staffAccess/$(request.auth.uid)).data;
      let policy = firestore.get(/databases/(default)/documents/_staffRoles/$(request.auth.token.staffRole)).data;
      return access.get('schemaVersion', 0) == 1 && access.get('enabled', false) == true &&
        access.get('epoch', '') == request.auth.token.gbStaffEpoch && access.get('roleId', '') == request.auth.token.staffRole &&
        policy.get('schemaVersion', 0) == 1 && policy.get('enabled', false) == true && permission in policy.get('permissions', []);
    }

    function can(permission) { return isAdmin() || (validStaffToken() && staffCan(permission)); }
    function canProductImage() { return can('products.manage') || can('products.images'); }
    function canScope(scope) {
      return (scope == 'categories' && can('categories.manage')) ||
        (scope == 'site' && can('branding.manage')) ||
        (scope == 'promotions' && can('promotions.manage'));
    }

    function isValidPendingArtwork(fileName, contentType) {
      return contentType is string && (
        (contentType == 'application/pdf' && fileName.matches('^[a-f0-9]{32}[.]pdf$')) ||
        (contentType == 'image/jpeg' && fileName.matches('^[a-f0-9]{32}[.]jpg$')) ||
        (contentType == 'image/png' && fileName.matches('^[a-f0-9]{32}[.]png$')) ||
        (contentType == 'image/webp' && fileName.matches('^[a-f0-9]{32}[.]webp$'))
      );
    }

    function isValidPendingArtworkKind(kind, contentType) {
      return kind == 'source-artwork' ||
        (kind == 'personalization-model' && contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ]);
    }

    function isValidCatalogImage(fileName, contentType) {
      return contentType is string && (
        (contentType == 'image/jpeg' && fileName.matches('^[a-f0-9]{32}[.]jpg$')) ||
        (contentType == 'image/png' && fileName.matches('^[a-f0-9]{32}[.]png$')) ||
        (contentType == 'image/webp' && fileName.matches('^[a-f0-9]{32}[.]webp$'))
      );
    }

    function isValidAdminOwner(ownerId) {
      return ownerId.matches('^[A-Za-z0-9_-]{1,100}$');
    }

    match /artworks/{userId}/pending/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        resource == null &&
        request.resource.size > 0 &&
        request.resource.size <= 15 * 1024 * 1024 &&
        isValidPendingArtwork(fileName, request.resource.contentType) &&
        request.resource.metadata.keys().hasAll(['ownerId', 'kind']) &&
        request.resource.metadata.ownerId == request.auth.uid &&
        isValidPendingArtworkKind(request.resource.metadata.kind, request.resource.contentType);
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /artworks/{userId}/orders/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /catalog/products/{productId}/{fileName} {
      // Imagens do catálogo são públicas; listagem e alterações continuam restritas.
      allow get: if true;
      allow list: if canProductImage();
      allow create: if canProductImage() &&
        resource == null &&
        request.resource.size > 0 &&
        request.resource.size <= 8 * 1024 * 1024 &&
        isValidCatalogImage(fileName, request.resource.contentType) &&
        request.resource.metadata.keys().hasAll(['uploadedBy']) &&
        request.resource.metadata.uploadedBy == request.auth.uid;
      allow update: if false;
      allow delete: if canProductImage();
    }

    match /catalog/{scope}/{ownerId}/{fileName} {
      allow get: if scope in ['categories', 'site', 'promotions'];
      allow list: if canScope(scope) && scope in ['categories', 'site', 'promotions'];
      allow create: if canScope(scope) &&
        scope in ['categories', 'site', 'promotions'] &&
        isValidAdminOwner(ownerId) &&
        resource == null &&
        request.resource.size > 0 &&
        request.resource.size <= 8 * 1024 * 1024 &&
        isValidCatalogImage(fileName, request.resource.contentType) &&
        request.resource.metadata.keys().hasAll(['uploadedBy']) &&
        request.resource.metadata.uploadedBy == request.auth.uid;
      allow update: if false;
      allow delete: if canScope(scope) && scope in ['categories', 'site', 'promotions'];
    }

    match /catalog/fonts/{fontId}/{fileName} {
      allow get: if true;
      allow list: if can('fonts.manage');
      allow create: if can('fonts.manage') &&
        isValidAdminOwner(fontId) &&
        resource == null &&
        request.resource.size > 0 &&
        request.resource.size <= 3 * 1024 * 1024 &&
        ((request.resource.contentType == 'font/woff2' && fileName.matches('^[a-f0-9]{32}[.]woff2$')) ||
         (request.resource.contentType == 'font/ttf' && fileName.matches('^[a-f0-9]{32}[.]ttf$')) ||
         (request.resource.contentType == 'font/otf' && fileName.matches('^[a-f0-9]{32}[.]otf$'))) &&
        request.resource.metadata.keys().hasAll(['uploadedBy']) &&
        request.resource.metadata.uploadedBy == request.auth.uid;
      allow update: if false;
      allow delete: if can('fonts.manage');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
