rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isValidPendingArtwork(fileName, contentType) {
      return contentType is string && (
        (contentType == 'application/pdf' && fileName.matches('^[a-f0-9]{32}[.]pdf$')) ||
        (contentType == 'image/jpeg' && fileName.matches('^[a-f0-9]{32}[.]jpg$')) ||
        (contentType == 'image/png' && fileName.matches('^[a-f0-9]{32}[.]png$')) ||
        (contentType == 'image/webp' && fileName.matches('^[a-f0-9]{32}[.]webp$'))
      );
    }

    match /artworks/{userId}/pending/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        resource == null &&
        request.resource.size > 0 &&
        request.resource.size <= 15 * 1024 * 1024 &&
        isValidPendingArtwork(fileName, request.resource.contentType) &&
        request.resource.metadata.keys().hasAll(['ownerId']) &&
        request.resource.metadata.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /artworks/{userId}/orders/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
