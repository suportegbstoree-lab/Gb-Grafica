{
  "firestore": [
    {
      "database": "ai-studio-2d6e0927-5895-447d-a355-298207aa71d2",
      "rules": "firestore.rules"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
