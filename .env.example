# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Mercado Pago Credentials (OBSOLETE)
MP_ACCESS_TOKEN=
VITE_MP_PUBLIC_KEY=

# PagBank Credentials
# Get your token at: https://painel.pagbank.com.br/configuracoes/integracoes
PAGBANK_TOKEN=
# Use 'sandbox' while testing, then change to 'production'
PAGBANK_ENV=sandbox

# Firebase Admin credentials (server-only; never use VITE_ here)
# Option 1: paste the complete service-account JSON as one Vercel variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option 2: use the three individual variables below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-2d6e0927-5895-447d-a355-298207aa71d2

# APP_URL: public Vercel URL, without a trailing slash.
# Example: https://gb-grafica.vercel.app
APP_URL=
