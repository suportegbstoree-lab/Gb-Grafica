# URL pública, sem barra no final. Em produção, use HTTPS.
APP_URL=http://localhost:3000

# Origens adicionais separadas por vírgula, caso frontend e API usem domínios diferentes.
APP_ALLOWED_ORIGINS=

# Desenvolvimento: escuta somente em 127.0.0.1 por padrão.
# Para LAN/túnel, habilite explicitamente e informe hosts EXATOS, sem URL/porta/curinga.
DEV_SERVER_ALLOW_NETWORK=false
# Exemplo: seu-subdominio-exato.trycloudflare.com
VITE_ALLOWED_HOSTS=
# Desliga HMR e o listener WebSocket do Vite.
DISABLE_HMR=false

# Logs JSON do servidor: info, warn, error ou silent.
LOG_LEVEL=info
# Stack traces ficam desativados para reduzir risco de dados em logs.
LOG_INCLUDE_STACK=false

# PagBank: use sandbox durante homologação e production somente com o token de produção.
PAGBANK_ENV=sandbox
PAGBANK_TOKEN=

# Correios: somente servidor. Nunca use prefixo VITE_ nestas variáveis.
CORREIOS_ENV=production
CORREIOS_ORIGIN_CEP=
# Códigos liberados no SEU contrato. Exemplo de formato: 03298:PAC,03220:SEDEX
# O exemplo não confirma quais códigos seu contrato autoriza.
CORREIOS_SERVICES=
# Token Bearer temporário gerado no CWS (pode colar com ou sem "Bearer ").
CORREIOS_TOKEN=
# Para renovação automática, preencha os três abaixo; eles têm prioridade sobre CORREIOS_TOKEN.
CORREIOS_USER=
CORREIOS_ACCESS_CODE=
CORREIOS_POSTING_CARD=
# Opcionais na autenticação por cartão de postagem:
CORREIOS_CONTRACT=
CORREIOS_REGIONAL=
# Armazena request/response reais para exportação da homologação. Só funciona em Sandbox.
PAGBANK_HOMOLOGATION_CAPTURE=false

# Validação final em produção: conta Firebase específica e janela UTC de até 2h.
# Ausentes/vazios mantêm a coleta de produção desligada. Não use variáveis VITE_*.
PAGBANK_PRODUCTION_CAPTURE_USER_ID=
PAGBANK_PRODUCTION_CAPTURE_START_AT=
PAGBANK_PRODUCTION_CAPTURE_END_AT=

# Firebase Admin: escolha JSON completo OU as três variáveis separadas.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_FIRESTORE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
# Proteção do backend próprio: off, monitor ou enforce.
# Comece em monitor e só use enforce depois de validar os logs em produção.
FIREBASE_APP_CHECK_MODE=off
# Opcional: App IDs adicionais separados por vírgula. Ausente usa apenas o app web deste projeto.
FIREBASE_APP_CHECK_ALLOWED_APP_IDS=

# Modelo legado: usado como fallback pelo servidor para preservar o ambiente existente.
VITE_GEMINI_MODEL=gemini-3.8-flash
# IA administrativa no servidor: mesma conta de serviço Firebase; sem chave Gemini pública.
# Ausente, o modelo usa VITE_GEMINI_MODEL por compatibilidade com o ambiente existente.
FIREBASE_AI_MODEL=
# Mantém global, o padrão do AgentPlatformBackend utilizado anteriormente.
FIREBASE_AI_LOCATION=global
# Site key pública do reCAPTCHA Enterprise registrada no Firebase App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Somente com npm run dev em localhost. O SDK gera o segredo no navegador.
# Nunca coloque aqui um token. Ausente ou false em qualquer build publicado.
VITE_APP_CHECK_DEBUG=false
