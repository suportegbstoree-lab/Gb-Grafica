# URL pública, sem barra no final. Em produção, use HTTPS.
APP_URL=http://localhost:3000

# Origens adicionais separadas por vírgula, caso frontend e API usem domínios diferentes.
APP_ALLOWED_ORIGINS=

# Hosts extras aceitos pelo Vite durante desenvolvimento local.
# Exemplo para Quick Tunnel: .trycloudflare.com
VITE_ALLOWED_HOSTS=

# Logs JSON do servidor: info, warn, error ou silent.
LOG_LEVEL=info
# Stack traces ficam desativados para reduzir risco de dados em logs.
LOG_INCLUDE_STACK=false

# PagBank: use sandbox durante homologação e production somente com o token de produção.
PAGBANK_ENV=sandbox
PAGBANK_TOKEN=
# Armazena request/response reais para exportação da homologação. Só funciona em Sandbox.
PAGBANK_HOMOLOGATION_CAPTURE=false

# Validação final em produção: conta Firebase específica e janela UTC de até 2h.
# Ausentes/vazios mantêm a coleta de produção desligada. Não use variáveis VITE_*.
PAGBANK_PRODUCTION_CAPTURE_USER_ID=
PAGBANK_PRODUCTION_CAPTURE_START_AT=
PAGBANK_PRODUCTION_CAPTURE_END_AT=

# Firebase Admin: escolha JSON completo OU as três variáveis separadas.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_FIRESTORE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
# Proteção do backend próprio: off, monitor ou enforce.
# Comece em monitor e só use enforce depois de validar os logs em produção.
FIREBASE_APP_CHECK_MODE=off
# Opcional: App IDs adicionais separados por vírgula. Ausente usa apenas o app web deste projeto.
FIREBASE_APP_CHECK_ALLOWED_APP_IDS=

# Firebase AI Logic usa a Agent Platform Gemini API sem chave secreta Gemini no cliente.
VITE_GEMINI_MODEL=gemini-3.8-flash
# Site key pública do reCAPTCHA Enterprise registrada no Firebase App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Somente com npm run dev em localhost. O SDK gera o segredo no navegador.
# Nunca coloque aqui um token. Ausente ou false em qualquer build publicado.
VITE_APP_CHECK_DEBUG=false
